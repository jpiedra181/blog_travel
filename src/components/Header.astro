---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="https://jpiedra181.github.io/blog_travel/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<!-- <HeaderLink href="index">Home</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/">Home</a>
			<!-- <HeaderLink href="blog">Blog</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/blog">Blog</a>
			<!-- <HeaderLink href="destination">Destinations</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/destination">Destinations</a>
			<!-- <HeaderLink href="about">About</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/about">About</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 1em 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		gap: 0.5em;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		h2 {
			font-size: 1em;
			text-align: center;
		}
		.internal-links {
			font-size: 1em;
			display: flex;
			gap: 0;
		}
	}
</style>
