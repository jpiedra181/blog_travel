---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="https://jpiedra181.github.io/blog_travel/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<!-- <HeaderLink href="index">Home</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/">Home</a>
			<!-- <HeaderLink href="blog">Blog</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/blog">Blog</a>
			<!-- <HeaderLink href="destination">Destinations</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/destination">Destinations</a>
			<!-- Dropdown Link -->
			<div id="dropdown_menu">
				<button id="destBtn">Destination</button>			  
				<ul id="dropdown">
				  <li><a href="https://jpiedra181.github.io/blog_travel/destination/europe/">Europe</a></li>
				  <li><a href="https://jpiedra181.github.io/blog_travel/destination/africa/">Africa</a></li>
				  <li><a href="https://jpiedra181.github.io/blog_travel/destination/asia/">Asia</a></li>
				  <li><a href="https://jpiedra181.github.io/blog_travel/destination/america/">America</a></li>
				  <li><a href="https://jpiedra181.github.io/blog_travel/destination/oceania/">Oceania</a></li>
				</ul>
			  </div>
			<!-- <HeaderLink href="about">About</HeaderLink> -->
			<a href="https://jpiedra181.github.io/blog_travel/about">About</a>
		</div>
	</nav>
</header>

<!-- Calling JavaScript file to implement dropdown button -->
 <script defer>
	const destBtn = document.getElementById('destBtn')
	const dropdown = document.getElementById('dropdown')

	if(dropdown.classList.contains('isActive')) {

	}

	destBtn.addEventListener('click', () => {
		if(dropdown.classList.contains('isActive')) {
			dropdown.style.display = 'none'
			dropdown.classList.remove('isActive')
		} else {
			dropdown.style.display = 'block'
			dropdown.classList.add('isActive')
		}
	})
 </script>

<style>
	#dropdown_menu {
		position: relative;
		display: inline-block;
	}
	#destBtn {
		background: transparent;
		border: none;
		font-size: 1em;
	}
	#dropdown {
		display: none;
		position: absolute;
		background-color: white;
		color: black;
		margin-top: 8px;
		padding: 8px;
		border-radius: 12px;
		flex-direction: column;
		gap: 6px;
	}
	#dropdown li {
		text-decoration: none;
	}
	header {
		margin: 0;
		padding: 1em 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links {
		display: flex;
		gap: 0.5em;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		h2 {
			font-size: 1em;
			text-align: center;
		}
		.internal-links {
			font-size: 1em;
			display: flex;
			gap: 0;
		}
	}
</style>
